@model IReadOnlyList<DemoMVC.Models.RoleListItemViewModel>

@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Role";
}

<section>
    <p class="admin-eyebrow mb-2">QUẢN TRỊ HỆ THỐNG</p>
    <h1 class="h2 mb-2">Quản lý Role</h1>
    <p class="text-secondary mb-4">
        Tạo Role và cấu hình quyền cho từng Action. Role mới mặc định không có quyền.
    </p>

    @if (TempData["AdminRolesMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["AdminRolesError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <form method="post" action="/Admin/Roles" class="card card-body mb-4">
        @Html.AntiForgeryToken()
        <label for="roleName" class="form-label fw-semibold">Tạo Role mới</label>
        <div class="d-flex gap-2">
            <input id="roleName" name="roleName" class="form-control" maxlength="256"
                   required autocomplete="off" />
            <button type="submit" class="btn btn-primary text-nowrap">Tạo Role</button>
        </div>
    </form>

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Số tài khoản</th>
                    <th>Quyền theo Action</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @role.Name
                            @if (role.IsBuiltIn)
                            {
                                <span class="badge text-bg-secondary ms-1">Mặc định</span>
                            }
                            else
                            {
                                <form method="post" action="/Admin/Roles/@role.Id/rename"
                                      class="d-flex gap-2 mt-2">
                                    @Html.AntiForgeryToken()
                                    <input name="roleName" class="form-control form-control-sm"
                                           value="@role.Name" maxlength="256" required
                                           aria-label="Tên mới cho Role @role.Name" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">
                                        Đổi tên
                                    </button>
                                </form>
                            }
                        </td>
                        <td>@role.UserCount</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               href="/Admin/Roles/@role.Id/permissions">Thiết lập quyền</a>
                        </td>
                        <td class="text-end">
                            @if (!role.IsBuiltIn)
                            {
                                <form method="post" action="/Admin/Roles/@role.Id/delete"
                                      onsubmit="return confirm('Xóa Role @role.Name?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            disabled="@(role.UserCount > 0)">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
