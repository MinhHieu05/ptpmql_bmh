@model IReadOnlyList<DemoMVC.Models.AdminUserListItemViewModel>

@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Phân quyền quản lý tài khoản";
    var availableRoles = (IReadOnlyList<string>)ViewBag.AvailableRoles;
}

<section>
    <p class="admin-eyebrow mb-2">QUẢN TRỊ HỆ THỐNG</p>
    <h1 class="h2 mb-2">Phân quyền quản lý tài khoản</h1>
    <p class="text-secondary mb-4">
        Gán một hoặc nhiều Role cho từng tài khoản. Quyền của tài khoản là hợp của các Role được gán.
    </p>

    @if (TempData["AdminUsersMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["AdminUsersError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="d-flex justify-content-end mb-3">
        <a href="/Admin/Roles" class="btn btn-outline-primary">Quản lý Role và quyền Action</a>
    </div>

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Email / trạng thái</th>
                    <th>Role (có thể chọn nhiều)</th>
                    <th>Trạng thái tài khoản</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@account.Email</div>
                            <small class="text-secondary">
                                @(account.EmailConfirmed ? "Email đã xác thực" : "Email chưa xác thực")
                            </small>
                        </td>
                        <td>
                            <form method="post" action="/Admin/Users/@account.Id/roles"
                                  class="d-flex flex-column align-items-start gap-2">
                                @Html.AntiForgeryToken()
                                <select name="roles" class="form-select form-select-sm"
                                        multiple size="@Math.Min(Math.Max(availableRoles.Count, 2), 5)"
                                        aria-label="Vai trò của @account.Email">
                                    @foreach (var role in availableRoles)
                                    {
                                        <option value="@role"
                                                selected="@account.Roles.Contains(role, StringComparer.OrdinalIgnoreCase)">
                                            @role
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Lưu Role</button>
                            </form>
                        </td>
                        <td>
                            <div class="mb-2">@(account.IsLockedOut ? "Đã khóa" : "Đang hoạt động")</div>
                            <form method="post" action="/Admin/Users/@account.Id/lockout">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="locked" value="@(!account.IsLockedOut)" />
                                <button type="submit"
                                        class="btn btn-sm @(account.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")">
                                    @(account.IsLockedOut ? "Mở khóa" : "Khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-secondary py-4">Chưa có tài khoản.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
