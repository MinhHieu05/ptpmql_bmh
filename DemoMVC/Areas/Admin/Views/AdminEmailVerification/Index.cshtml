@model IReadOnlyList<DemoMVC.Models.AdminEmailVerificationItemViewModel>

@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hộp thư xác thực email";
}

<section>
    <p class="admin-eyebrow mb-2">THÔNG BÁO HỆ THỐNG</p>
    <h1 class="h2 mb-2">Yêu cầu xác thực email</h1>
    <p class="text-secondary mb-4">
        Các yêu cầu do User gửi xuất hiện tại đây. Nếu User cũng đã yêu cầu OTP, mã chỉ Admin đã đăng nhập được xem và hết hạn sau 10 phút.
    </p>

    @if (TempData["EmailVerificationMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["EmailVerificationError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Email đăng ký</th>
                    <th>Mã OTP</th>
                    <th>Hạn sử dụng</th>
                    <th>Quyết định</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model)
                {
                    <tr>
                        <td>@account.Email</td>
                        <td>
                            @if (account.Otp != null)
                            {
                                <span class="fs-5 fw-semibold font-monospace">@account.Otp</span>
                            }
                            else
                            {
                                <span class="text-secondary">Mã chưa có hoặc đã hết hạn</span>
                            }
                        </td>
                        <td>
                            @(account.ExpiresAt?.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy") ?? "—")
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <form asp-area="Admin" asp-controller="AdminEmailVerification"
                                      asp-action="Confirm" asp-route-id="@account.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">Đồng ý</button>
                                </form>
                                <form asp-area="Admin" asp-controller="AdminEmailVerification"
                                      asp-action="Reject" asp-route-id="@account.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Từ chối</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">
                            Không có yêu cầu xác thực nào đang chờ duyệt.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
