@model DemoMVC.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Gửi lại email xác thực";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Gửi lại email xác thực</h1>
        <p class="text-secondary">Nhập email đã đăng ký. Nếu tài khoản chưa xác thực, hướng dẫn sẽ được gửi lại.</p>
        <form asp-action="ResendConfirmation" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Gửi lại email</button>
            <a asp-action="Login" class="btn btn-link">Quay lại đăng nhập</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
