@model DemoMVC.Models.RegisterConfirmationViewModel

@{
    ViewData["Title"] = "Xác thực email";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Kiểm tra email</h1>
        @if (Model.IsResendResult)
        {
            <div class="alert alert-info" role="status">
                Nếu địa chỉ email thuộc tài khoản chưa xác thực, hướng dẫn sẽ được gửi. Hãy kiểm tra hộp thư và thư rác.
            </div>
        }
        else if (Model.EmailSent)
        {
            <div class="alert alert-success" role="status">
                Email xác thực đã được gửi. Hãy mở email và bấm liên kết để kích hoạt tài khoản trước khi đăng nhập.
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="status">
                Tài khoản đã được tạo nhưng chưa gửi được email xác thực. Kiểm tra cấu hình SMTP hoặc liên hệ quản trị viên.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <p class="text-secondary">Địa chỉ email: @Model.Email</p>
            <form asp-action="ResendConfirmation" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@Model.Email" />
                <button type="submit" class="btn btn-outline-primary">Gửi lại email xác thực</button>
            </form>
        }
        <a asp-action="Login">Về trang đăng nhập</a>
    </div>
</div>
