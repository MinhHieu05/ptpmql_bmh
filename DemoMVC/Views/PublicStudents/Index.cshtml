@model DemoMVC.Models.PublicStudentListViewModel

@{
    Layout = User.IsInRole("Admin")
        ? "/Areas/Admin/Views/Shared/_AdminLayout.cshtml"
        : "/Views/Student/_StudentLayout.cshtml";
    ViewData["Title"] = "Danh sách sinh viên công khai";
}

<section class="student-portal">
    <div class="student-portal-hero">
        <div>
            <p class="student-eyebrow mb-2">THÔNG TIN ĐÃ ĐƯỢC DUYỆT</p>
            <h1 class="h2">Danh sách sinh viên</h1>
            <p class="text-secondary mb-0">Chỉ hồ sơ đã được Admin duyệt mới xuất hiện tại đây.</p>
        </div>
    </div>

    <form method="get" class="student-portal-card p-3 mb-3">
        <label for="student-search" class="form-label">Tìm theo mã sinh viên hoặc họ tên</label>
        <div class="input-group">
            <input id="student-search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Nhập mã sinh viên hoặc họ tên" />
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
    </form>

    <div class="student-portal-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã sinh viên</th>
                        <th>Họ và tên</th>
                        <th>Ngành học</th>
                        <th>Năm nhập học</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Students.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-5">
                                @(string.IsNullOrEmpty(Model.Search)
                                    ? "Chưa có sinh viên nào được duyệt."
                                    : "Không tìm thấy sinh viên phù hợp với từ khóa.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td class="fw-semibold">@student.StudentCode</td>
                                <td>@student.Name</td>
                                <td>@student.MajorName</td>
                                <td>@student.EnrollmentYear</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalItems > 0)
    {
        <nav class="mt-3" aria-label="Phân trang danh sách sinh viên">
            <ul class="pagination justify-content-center flex-wrap">
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page - 1)">Trang trước</a>
                    </li>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@pageNumber"
                           aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                    </li>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page + 1)">Trang tiếp theo</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <p class="text-center text-secondary mt-3 mb-0" aria-live="polite">
        Trang @Model.Page / @Model.TotalPages · @Model.TotalItems sinh viên
    </p>
</section>
