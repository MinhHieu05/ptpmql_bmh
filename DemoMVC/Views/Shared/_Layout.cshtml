<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DemoMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DemoMVC.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom home-site-nav">
            <div class="container">
                <a class="navbar-brand home-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="home-brand-mark" aria-hidden="true">D</span>
                    <span>DemoMVC<small>CỔNG THÔNG TIN SINH VIÊN</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1 home-main-nav">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="PublicStudents" asp-action="Index">Danh sách sinh viên</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Admin">
                                    Tổng quan
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Admin/Students">
                                    Quản lý sinh viên
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/PublicStudents">
                                    Danh sách công khai
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("User"))
                        {
                            @if (User.HasClaim(DemoMVC.Services.StudentProfilePermissions.ClaimType, DemoMVC.Services.StudentProfilePermissions.View))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Student/Profiles">Hồ sơ của tôi</a>
                                </li>
                            }
                            @if (User.HasClaim(DemoMVC.Services.StudentProfilePermissions.ClaimType, DemoMVC.Services.StudentProfilePermissions.Create))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Student/Register">Đăng ký hồ sơ</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/PublicStudents">
                                    Danh sách công khai
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center home-account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Manage">Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link home-login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link home-register-link" asp-controller="Account" asp-action="Register">Tạo tài khoản</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
         ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <main role="main" class="public-home-main">@RenderBody()</main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">@RenderBody()</main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DemoMVC - Cổng thông tin sinh viên
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                 ViewContext.RouteData.Values["action"]?.ToString() == "Index")
            {
                <span> · </span><a asp-controller="PublicStudents" asp-action="Index">Danh sách công khai</a>
            }
            else
            {
                <span> · </span><a asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
