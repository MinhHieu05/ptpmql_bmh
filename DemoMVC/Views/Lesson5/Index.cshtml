@section Styles {
    <link rel="stylesheet" href="~/css/lesson5.css" />
}
<div class="lesson5-container">

    <h2 class="lesson5-title">
        Lesson 5 - TempData
    </h2>

    <form asp-action="Index" method="post">

        <div class="mb-3">
            <label class="form-label">
               Nhập họ tên:
            </label>

            <input type="text"
                   name="name"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-primary lesson5-button">
            Gửi dữ liệu
        </button>

    </form>

    @if (TempData["Message"] != null)
    {
        <div class="lesson5-message">
            @TempData["Message"]
        </div>
    }

</div>

