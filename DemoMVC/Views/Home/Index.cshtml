@inject DemoMVC.Services.DynamicActionPermissionService PermissionService

@{
    ViewData["Title"] = "Trang chủ";
    var canAccessAdmin = await PermissionService.IsAllowedAsync(User, "Admin", "Admin", "Index");
    var canViewProfiles = await PermissionService.IsAllowedAsync(User, null, "Student", "Profiles");
    var canCreateProfiles = await PermissionService.IsAllowedAsync(User, null, "Student", "Register");
}

<div class="public-home">
    <section class="home-hero">
        <div class="home-hero-copy">
            <span class="home-kicker"><span></span> NỀN TẢNG QUẢN LÝ SINH VIÊN</span>
            <h1>Quản lý học tập<br /><span>gọn gàng hơn.</span></h1>
            <p class="home-lead">
                Một nơi để sinh viên gửi hồ sơ, theo dõi trạng thái và tra cứu danh sách công khai
                — đơn giản, rõ ràng và thuận tiện.
            </p>
            <div class="home-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (canAccessAdmin)
                    {
                        <a class="btn home-btn-primary" href="/Admin">Vào trang quản trị <span aria-hidden="true">→</span></a>
                    }
                    else if (canViewProfiles)
                    {
                        <a class="btn home-btn-primary" href="/Student/Profiles">Hồ sơ của tôi <span aria-hidden="true">→</span></a>
                    }
                    else if (canCreateProfiles)
                    {
                        <a class="btn home-btn-primary" href="/Student/Register">Đăng ký hồ sơ <span aria-hidden="true">→</span></a>
                    }
                    else
                    {
                        <a class="btn home-btn-primary" href="/Account/AccessDenied">Xem quyền tài khoản <span aria-hidden="true">→</span></a>
                    }
                }
                else
                {
                    <a class="btn home-btn-primary" asp-controller="Account" asp-action="Register">
                        Bắt đầu đăng ký <span aria-hidden="true">→</span>
                    </a>
                    <a class="home-btn-secondary" asp-controller="Account" asp-action="Login">Đăng nhập tài khoản</a>
                }
            </div>
            <div class="home-proof" aria-label="Ưu điểm của cổng sinh viên">
                <div><strong>1 chỗ</strong><span>Quản lý hồ sơ</span></div>
                <div><strong>Rõ ràng</strong><span>Trạng thái duyệt</span></div>
                <div><strong>Thuận tiện</strong><span>Tra cứu công khai</span></div>
            </div>
            <a class="home-public-link" asp-controller="PublicStudents" asp-action="Index">
                Khám phá danh sách sinh viên công khai <span aria-hidden="true">↗</span>
            </a>
        </div>

        <div class="home-hero-art" aria-label="Minh họa bảng theo dõi hồ sơ sinh viên" role="img">
            <div class="home-art-orbit home-art-orbit-one"></div>
            <div class="home-art-orbit home-art-orbit-two"></div>
            <div class="home-art-spark home-art-spark-one">✦</div>
            <div class="home-art-spark home-art-spark-two">✳</div>
            <div class="home-art-card">
                <div class="home-art-card-header">
                    <div>
                        <span class="home-art-caption">CỔNG SINH VIÊN</span>
                        <h2>Tổng quan hồ sơ</h2>
                    </div>
                    <span class="home-art-menu" aria-hidden="true">•••</span>
                </div>
                <div class="home-art-summary">
                    <div class="home-art-avatar">SV</div>
                    <div>
                        <strong>Hồ sơ của bạn</strong>
                        <span>Theo dõi mọi lúc</span>
                    </div>
                    <span class="home-art-check" aria-label="Đã sẵn sàng">✓</span>
                </div>
                <div class="home-art-progress-label"><span>Tiến trình hồ sơ</span><strong>75%</strong></div>
                <div class="home-art-progress"><span></span></div>
                <div class="home-art-steps">
                    <div class="home-art-step is-complete"><span>✓</span><div><strong>Thông tin cá nhân</strong><small>Đã hoàn thành</small></div></div>
                    <div class="home-art-step is-active"><span>2</span><div><strong>Gửi hồ sơ</strong><small>Sẵn sàng thực hiện</small></div></div>
                    <div class="home-art-step"><span>3</span><div><strong>Chờ xét duyệt</strong><small>Cập nhật trạng thái tại đây</small></div></div>
                </div>
            </div>
            <div class="home-art-note">
                <span class="home-art-note-icon">✓</span>
                <span><strong>Dễ dàng theo dõi</strong><small>Trạng thái hồ sơ rõ ràng</small></span>
            </div>
        </div>
    </section>

    <section class="home-benefits" aria-label="Lợi ích của cổng sinh viên">
        <article class="home-benefit">
            <span class="home-benefit-icon home-icon-blue" aria-hidden="true">01</span>
            <div><h2>Đăng ký trực tuyến</h2><p>Gửi hồ sơ sinh viên thuận tiện, không cần thao tác phức tạp.</p></div>
        </article>
        <article class="home-benefit">
            <span class="home-benefit-icon home-icon-mint" aria-hidden="true">02</span>
            <div><h2>Theo dõi minh bạch</h2><p>Biết hồ sơ đang chờ duyệt hay đã được quản trị viên xác nhận.</p></div>
        </article>
        <article class="home-benefit">
            <span class="home-benefit-icon home-icon-peach" aria-hidden="true">03</span>
            <div><h2>Tra cứu công khai</h2><p>Tìm kiếm thông tin sinh viên đã được duyệt nhanh chóng.</p></div>
        </article>
    </section>

    <section class="home-bottom-cta">
        <div>
            <span class="home-kicker">SẴN SÀNG BẮT ĐẦU?</span>
            <h2>Tài khoản của bạn, hồ sơ của bạn.</h2>
            <p>Đăng ký tài khoản để sử dụng các chức năng được quản trị viên cấp quyền.</p>
        </div>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn home-btn-light" asp-controller="Account" asp-action="Register">Tạo tài khoản miễn phí <span aria-hidden="true">→</span></a>
        }
        else
        {
            <a class="btn home-btn-light" asp-controller="Account" asp-action="Manage">Quản lý tài khoản <span aria-hidden="true">→</span></a>
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
