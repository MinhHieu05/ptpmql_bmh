@{
    ViewData["Title"] = "Math - Talent And Training";
}

<style>
    body {
        margin: 0;
        background-color: #f5f7fb;
        font-family: Arial, sans-serif;
    }

    .home-container {
        max-width: 1000px;
        margin: 80px auto;
        padding: 50px 40px;
        text-align: center;
        background-color: white;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .home-title {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #222;
    }

    .home-subtitle {
        font-size: 24px;
        margin-bottom: 15px;
        color: #444;
    }

    .home-description {
        font-size: 20px;
        line-height: 1.6;
        color: #666;
        margin-top: 25px;
    }

    .fanpage-box {
        margin-top: 35px;
        padding: 25px;
        background-color: #f8f8f8;
        border-radius: 15px;
    }

    .fanpage-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .fanpage-button {
        display: inline-block;
        padding: 14px 30px;
        background-color: #ff9800;
        color: white;
        text-decoration: none;
        font-size: 18px;
        font-weight: bold;
        border-radius: 10px;
        transition: 0.3s;
    }

    .fanpage-button:hover {
        background-color: #e68900;
        transform: translateY(-2px);
    }
</style>


<div class="home-container">

    <h1 class="home-title">
        Welcome to Math - Talent And Training
    </h1>

    <div class="home-subtitle">
        MHieu Học Toán - Lớp học tập vừa và nhỏ, đảm bảo chất lượng </br>
        Hướng tới kì thi tốt nghiệp THPTQG năm 2027
    </div>

    <div class="fanpage-box">
        <div class="fanpage-title">
            Tìm hiểu thêm về lớp học tại đây: <a href="https://www.facebook.com/math.talent.and.training" target="_blank"> MHieu Học Toán </a>
        </div>

        <div class="home-description">
            Đường đời là chiếc thang không nấc chót, học tập là quyển vở không có trang cuối cùng.</br>
            Chủ tịch: Hồ Chí Minh - Tư tưởng học tập suốt đời của Người. </br>
        </div>
    </div>

</div>