
@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Sửa thông tin sinh viên";
}

<h1>Sửa thông tin sinh viên</h1>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="StudentCode" />

            <div class="form-group mb-3">
                <label asp-for="StudentCode"></label>
                <input value="@Model.StudentCode"
                       class="form-control"
                       readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EnrollmentYear"></label>
                <select asp-for="EnrollmentYear"
                        asp-items="ViewBag.EnrollmentYear"
                        class="form-select"></select>
                <span asp-validation-for="EnrollmentYear"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainingSystem"></label>
                <select asp-for="TrainingSystem"
                        asp-items="ViewBag.TrainingSystem"
                        class="form-select"></select>
                <span asp-validation-for="TrainingSystem"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MajorCode"></label>
                <select asp-for="MajorCode"
                        asp-items="ViewBag.MajorCode"
                        class="form-select">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="MajorCode"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="DateOfBirth"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email"
                       type="email"
                       class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>
                <a asp-action="Index"
                   class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
