@model DemoMVC.Models.StudentDeleteViewModel
@inject DemoMVC.Services.DynamicActionPermissionService PermissionService

@{
    Layout = "/Views/Student/_StudentLayout.cshtml";
    ViewData["Title"] = "Đã xóa hồ sơ";
    var canViewProfiles = await PermissionService.IsAllowedAsync(User, null, "Student", "Profiles");
    var canCreateProfiles = await PermissionService.IsAllowedAsync(User, null, "Student", "Register");
}

<section class="student-portal-form">
    <div class="alert alert-success" role="status">
        Hồ sơ <strong>@Model.Name</strong> (@Model.StudentCode) đã được xóa.
    </div>
    <div class="d-flex gap-2">
        @if (canViewProfiles)
        {
            <a asp-action="Profiles" class="btn btn-primary">Quay lại hồ sơ của tôi</a>
        }
        @if (canCreateProfiles)
        {
            <a asp-action="Register" class="btn btn-outline-primary">Đăng ký hồ sơ mới</a>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/student-portal.css" asp-append-version="true" />
}
