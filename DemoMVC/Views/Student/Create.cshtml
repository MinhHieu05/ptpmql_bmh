
@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h1>Thêm sinh viên</h1>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-controller="Student"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EnrollmentYear"
                       class="control-label"></label>
                <select asp-for="EnrollmentYear"
                        asp-items="ViewBag.EnrollmentYear"
                        class="form-select">
                </select>
                <span asp-validation-for="EnrollmentYear"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainingSystem"
                       class="control-label"></label>
                <select asp-for="TrainingSystem"
                        asp-items="ViewBag.TrainingSystem"
                        class="form-select">
                    <option value="">-- Chọn hệ đào tạo --</option>
                </select>
                <span asp-validation-for="TrainingSystem"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MajorCode"
                       class="control-label"></label>
                <select asp-for="MajorCode"
                        asp-items="ViewBag.MajorCode"
                        class="form-select">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="MajorCode"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DateOfBirth"
                       class="control-label"></label>
                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="DateOfBirth"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address"
                       class="control-label"></label>
                <input asp-for="Address"
                       class="form-control" />
                <span asp-validation-for="Address"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email"
                       class="control-label"></label>
                <input asp-for="Email"
                       type="email"
                       class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit"
                        class="btn btn-primary">
                    Thêm sinh viên
                </button>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
