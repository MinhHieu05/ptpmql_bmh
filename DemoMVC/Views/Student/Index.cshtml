
@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm sinh viên
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã sinh viên</th>
            <th>Họ và tên</th>
            <th>Năm nhập học</th>
            <th>Hệ đào tạo</th>
            <th>Ngành học</th>
            <th>Ngày sinh</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentCode</td>
                <td>@item.Name</td>
                <td>@item.EnrollmentYear</td>
                <td>
                    @(item.TrainingSystem == "21"
                        ? "Đại học chính quy"
                        : item.TrainingSystem == "20"
                            ? "Đại học không chính quy"
                            : item.TrainingSystem)
                </td>
                <td>@(item.Major?.MajorName ?? "Chưa có ngành học")</td>
                <td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                <td>@item.Address</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.StudentCode">Sửa</a> |
                    <a asp-action="Details"
                       asp-route-id="@item.StudentCode">Chi tiết</a> |
                    <a asp-action="Delete"
                       asp-route-id="@item.StudentCode">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
