@model IReadOnlyList<DemoMVC.Models.Student>
@inject DemoMVC.Services.DynamicActionPermissionService PermissionService

@{
    Layout = "/Views/Student/_StudentLayout.cshtml";
    ViewData["Title"] = "Cổng sinh viên";
    var canCreate = await PermissionService.IsAllowedAsync(User, null, "Student", "Register");
    var canEdit = await PermissionService.IsAllowedAsync(User, null, "Student", "Edit");
    var canDelete = await PermissionService.IsAllowedAsync(User, null, "Student", "Delete");
    var canViewProfile = await PermissionService.IsAllowedAsync(User, null, "Student", "Profile");
}

<section class="student-portal">
    <div class="student-portal-hero">
        <div>
            <p class="student-eyebrow mb-2">CỔNG SINH VIÊN</p>
            <h1 class="h2">Hồ sơ của tôi</h1>
            <p class="text-secondary mb-0">Đăng ký hồ sơ mới hoặc xem những hồ sơ bạn đã gửi.</p>
        </div>
        @if (canCreate)
        {
            <a asp-controller="Student" asp-action="Register" class="btn btn-primary">Đăng ký hồ sơ</a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <div class="student-portal-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã sinh viên</th>
                        <th>Họ và tên</th>
                        <th>Ngành học</th>
                        <th>Năm nhập học</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-5">
                                Bạn chưa đăng ký hồ sơ nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@student.StudentCode</td>
                                <td>@student.Name</td>
                                <td>@(student.Major?.MajorName ?? student.MajorCode)</td>
                                <td>@student.EnrollmentYear</td>
                                <td>
                                    @if (student.IsApproved)
                                    {
                                        <span class="badge text-bg-success">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Chờ Admin duyệt</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (canViewProfile)
                                    {
                                        <a asp-action="Profile" asp-route-id="@student.StudentCode"
                                           class="btn btn-sm btn-outline-primary">Xem hồ sơ</a>
                                    }
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@student.StudentCode"
                                           class="btn btn-sm btn-outline-secondary">Sửa</a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a asp-action="Delete" asp-route-id="@student.StudentCode"
                                           class="btn btn-sm btn-outline-danger">Xóa</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/student-portal.css" asp-append-version="true" />
}
