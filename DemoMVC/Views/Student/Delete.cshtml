@model DemoMVC.Models.StudentDeleteViewModel

@{
    Layout = "/Views/Student/_StudentLayout.cshtml";
    ViewData["Title"] = "Xóa hồ sơ sinh viên";
}

<section class="student-portal-form">
    <p class="student-eyebrow mb-2">HỒ SƠ CỦA TÔI</p>
    <h1 class="h2 mb-3">Xác nhận xóa hồ sơ</h1>
    <div class="alert alert-warning" role="alert">
        Bạn có chắc muốn xóa hồ sơ <strong>@Model.Name</strong> (@Model.StudentCode)?
        Thao tác này không thể hoàn tác.
    </div>
    <form asp-action="Delete" asp-route-id="@Model.StudentCode" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Xóa hồ sơ</button>
        @if (User.HasClaim(DemoMVC.Services.StudentProfilePermissions.ClaimType, DemoMVC.Services.StudentProfilePermissions.View))
        {
            <a asp-action="Profile" asp-route-id="@Model.StudentCode"
               class="btn btn-outline-secondary">Hủy</a>
        }
    </form>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/student-portal.css" asp-append-version="true" />
}
